.DS_Store

node_modules
dist
*.local
*.tsbuildinfo

# TanStack Router's temporary files. The route tree itself, apps/web/src/routeTree.gen.ts, is
# committed.
.tanstack/

.env
.env.*
!.env.example
# The web app's dev defaults (the data mode), with no secrets.
!apps/web/.env.development

# AI agent worktrees.
.claude/worktrees/

# The impeccable design tool's decision mocks. Only the chosen sketch is kept: the build of the
# habit list matches it.
apps/web/.impeccable/mocks/*
!apps/web/.impeccable/mocks/decision/
apps/web/.impeccable/mocks/decision/*
!apps/web/.impeccable/mocks/decision/r3-color-icons.html

# The impeccable finish review's captures: evidence for one review, not source.
apps/web/.impeccable/review/

# Local screenshots and scratch pages of design work, not source.
.shots/

# Exports from other apps for the import scripts (docs/import.md). Personal data: never committed.
imports/
